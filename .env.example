# Copy this file to .env for local development — python-dotenv loads it
# automatically (see app/config.py). On Railway, set these as project
# "Variables" instead; never commit a real .env file.

# --- Data / storage (defaults are fine for most cases) ---
# DATA_DIR=data
# STORAGE_DIR=storage

# --- CORS ---
# CORS_ORIGINS=*

# --- Pagination ---
# DEFAULT_PAGE_SIZE=50
# MAX_PAGE_SIZE=500

# --- LLM endpoint (see README.md section 9) ---
# Setting OPENAI_API_KEY is what turns the endpoint on at all.
OPENAI_API_KEY=
# Fixed model — the client cannot choose one.
LLM_MODEL=gpt-5-nano
# Fixed max output length, passed to OpenAI as max_completion_tokens.
# LLM_MAX_COMPLETION_TOKENS=600
# LLM_REQUEST_TIMEOUT=30
# Per-message / whole-conversation / message-count limits.
# LLM_MAX_MESSAGE_CHARS=4000
# LLM_MAX_TOTAL_CHARS=8000
# LLM_MAX_MESSAGES=40
# Raw HTTP body cap for POST /llm/chat, enforced before parsing.
# LLM_MAX_HTTP_BODY_BYTES=20000
# Rate limit: N requests per caller (X-Session-Id, or IP as fallback) per window.
# LLM_RATE_LIMIT_MAX_REQUESTS=5
# LLM_RATE_LIMIT_WINDOW_SECONDS=1
# Global concurrency cap across all callers combined.
# LLM_MAX_CONCURRENT_REQUESTS=100

# No access token / shared secret is used for the LLM endpoint by design
# (see README.md section 9). Total spend is bounded on the OpenAI side
# instead — set a hard project budget there.

# --- Session isolation ---
# The X-Session-Id header name and min/max length are fixed in
# app/config.py (not env-configurable), since the notebook and the API
# must agree on the header name.
